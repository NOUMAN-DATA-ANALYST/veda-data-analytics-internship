        "import sqlite3\n",
        "\n",
        "# 1. In-memory SQLite database connect karna aur DataFrame ko table me save karna\n",
        "conn = sqlite3.connect(':memory:')\n",
        "df.to_sql('titles', conn, index=False, if_exists='replace')\n",
        "\n",
        "# Query 1: Movies vs TV Shows count year-wise\n",
        "query1 = \"\"\"\n",
        "SELECT release_year, type, COUNT(*) as total_titles\n",
        "FROM titles\n",
        "WHERE release_year >= 2010\n",
        "GROUP BY release_year, type\n",
        "ORDER BY release_year DESC;\n",
        "\"\"\"\n",
        "df_sql1 = pd.read_sql_query(query1, conn)\n",
        "print(\"--- SQL Query 1: Year-wise Content Count ---\")\n",
        "print(df_sql1.head(10))\n",
        "\n",
        "# Query 2: Top 10 content producing countries\n",
        "query2 = \"\"\"\n",
        "SELECT country, COUNT(*) as content_count\n",
        "FROM titles\n",
        "WHERE country != 'Unknown'\n",
        "GROUP BY country\n",
        "ORDER BY content_count DESC\n",
        "LIMIT 10;\n",
        "\"\"\"\n",
        "df_sql2 = pd.read_sql_query(query2, conn)\n",
        "print(\"\\n--- SQL Query 2: Top 10 Countries ---\")\n",
        "print(df_sql2)"
